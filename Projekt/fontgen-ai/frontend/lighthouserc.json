{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/fontgen-ai/",
        "http://localhost:3000/fontgen-ai/generate",
        "http://localhost:3000/fontgen-ai/editor"
      ],
      "numberOfRuns": 1,
      "staticDistDir": "./dist",
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-dev-shm-usage"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.85 }],
        "categories:pwa": ["error", { "minScore": 0.80 }],
        "uses-responsive-images": ["error", { "minScore": 0.90 }],
        "uses-webp-images": ["error", { "minScore": 0.80 }],
        "csp-xss": "off",
        "network-requests": "off"
      }
    }
  }
}
