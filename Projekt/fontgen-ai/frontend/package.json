{
  "name": "fontgen-ai-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh-pages": "tsc && vite build --outDir ../docs",
    "generate-static-files": "node scripts/generate-static-files.js",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.39.0",
    "clipper-lib": "^6.4.2",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.16",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.7",
    "workbox-cli": "^7.0.0"
  }
}
